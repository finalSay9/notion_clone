generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Document {
  id          String   @id @default(uuid())
  createdById String
  content     String   @default("")
  title       String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([createdById])
}