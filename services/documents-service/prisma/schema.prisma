generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Document {
  id          String   @id @default(uuid())
  createdById String

  // Keep this for now as a plain-text/HTML fallback.
  content     String   @default("")

  // Persisted Yjs document state.
  contentBinary    Bytes?

  title       String

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([createdById])
}